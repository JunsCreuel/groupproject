      .querySelectorAll(".map-node")
      .forEach(node => {

        const nodeCountry =
          CITY_COUNTRY[
            node.dataset.city
          ];

        node.classList.toggle(
          "is-selected-country",
          nodeCountry === country
        );

      });


    document
      .getElementById(
        "clearFinalCountry"
      )
      ?.addEventListener(
        "click",
        event => {

          event.stopPropagation();

          document
            .querySelectorAll(
              ".map-node"
            )
            .forEach(node =>
              node.classList.remove(
                "is-selected-country"
              )
            );

          renderLogs(history);

          intercept.textContent =
            "GLOBAL SIGNAL NETWORK // ALL LANGUAGES";

        }
      );

  }


  /*
    MAP NODE 클릭
    기존 listener보다 먼저 처리
  */

  document.addEventListener(
    "click",
    event => {

      const node =
        event.target.closest(
          ".map-node"
        );

      if (node) {

        const country =
          CITY_COUNTRY[
            node.dataset.city
          ];

        if (!country) return;

        event.preventDefault();
        event.stopImmediatePropagation();

        renderCountry(country);

        return;
      }


      /*
        COUNTRY INDEX 버튼도 동일하게 처리
      */

      const countryButton =
        event.target.closest(
          "[data-country]"
        );

      if (!countryButton) return;

      const country =
        countryButton.dataset.country;

      if (
        !country ||
        country === "ALL"
      ) {
        return;
      }

      if (!COUNTRY_CONFIG[country]) {
        return;
      }

      event.preventDefault();
      event.stopImmediatePropagation();

      document
        .querySelectorAll(
          "[data-country]"
        )
        .forEach(button =>
          button.classList.remove(
            "is-active"
          )
        );

      countryButton.classList.add(
        "is-active"
      );

      renderCountry(country);

    },
    true
  );

})();


